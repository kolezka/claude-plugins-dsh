{
  "name": "claude-plugin-dsh",
  "version": "0.2.0",
  "description": "Run unmodified Claude Code plugins inside DeepSeek Harness (DSH)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/claude-compat.d.ts",
      "default": "./dist/claude-compat.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "claude-plugin-dsh": "dist/bin/cli.js",
    "claude-plugins-dsh": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && esbuild src/claude-compat.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/claude-compat.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && node --test test/*.test.mjs",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Mariusz Rakus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolezka/claude-plugins-dsh.git"
  },
  "homepage": "https://github.com/kolezka/claude-plugins-dsh#readme",
  "bugs": "https://github.com/kolezka/claude-plugins-dsh/issues",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "claude-code",
    "claude-code-plugins",
    "cordis"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.4",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
